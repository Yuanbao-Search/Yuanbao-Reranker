{
  "model": "Qwen/Qwen3-0.6B",
  "max_length": 512,
  "attention": "sdpa",
  "rank_weight": 0.1,
  "tie_epsilon": 0.2,
  "max_gap": 4.0,
  "training": {
    "max_steps": 2,
    "per_device_train_batch_size": 1,
    "learning_rate": 1e-05,
    "optim": "adamw_torch",
    "remove_unused_columns": false,
    "report_to": "none",
    "logging_steps": 1,
    "save_strategy": "no",
    "seed": 42,
    "data_seed": 42,
    "dataloader_num_workers": 0
  }
}
