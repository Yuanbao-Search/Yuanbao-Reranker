    "MTEB-Code": {
      "batch_size": 512,
      "tensor_parallel_size": 1,
      "max_num_seqs": 512,
      "distributed_executor_backend": "uni"
    }
  },
  "environment": {
    "VLLM_USE_V1": "1",
    "VLLM_ENABLE_V1_MULTIPROCESSING": "0"
  }
}
