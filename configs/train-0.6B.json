{
  "model": "Qwen/Qwen3-0.6B",
  "max_length": 4096,
  "attention": "sdpa",
  "rank_weight": 0.1,
  "tie_epsilon": 0.2,
  "max_gap": 4.0,
  "training": {
    "num_train_epochs": 1,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 1,
    "learning_rate": 1e-05,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.02,
    "weight_decay": 0.0,
    "max_grad_norm": 1.0,
    "bf16": true,
    "optim": "adamw_torch_fused",
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_epsilon": 1e-08,
    "gradient_checkpointing": true,
    "gradient_checkpointing_kwargs": {
      "use_reentrant": true
    },
    "remove_unused_columns": false,
    "report_to": "none",
    "logging_steps": 10,
    "save_steps": 2000,
    "save_total_limit": 3,
    "seed": 42,
    "data_seed": 42,
    "dataloader_num_workers": 4,
    "deepspeed": "zero2.json",
    "ddp_timeout": 7200
  }
}
